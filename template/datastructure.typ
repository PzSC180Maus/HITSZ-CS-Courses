  2. 代码：
  ```c
  bool IsCompleteTree(BiTree T) {
      if (T == NULL) return true;
      queue<BiTree> q;
      q.push(T);
      bool flag = false;  // 标记是否遇到过空节点
      
      while (!q.empty()) {
          BiTree p = q.front(); q.pop();
          if (p == NULL) {
              flag = true;
          } else {
              if (flag) return false;  // 空节点后又出现非空节点
              q.push(p->lchild);
              q.push(p->rchild);
          }
      }
      return true;
  }
  ```
  
  3. 时间复杂度：$O(n)$，空间复杂度：$O(w)$，$w$为树的最大宽度。
]
